# Copy to .env for local runs (`npm run dev`, `npm start`) or next to docker-compose.yml.
# Real environment variables always win over this file. Everything here is optional.

# --- Server -------------------------------------------------------------------
# API port (production serves the app on this port too).
PORT=3000
# Vite dev server port (`npm run dev` only); it proxies /api to PORT.
VITE_PORT=5173
# Where club.db lives. Docker uses /data.
DATA_DIR=./.data

# Public base URL used in email links (sign-in links, confirmations, invites).
# The setup wizard saves the URL you open it from (Settings → Club); this is a fallback.
# APP_URL=https://booking.yourclub.com

# Behind a reverse proxy (Caddy, nginx, Railway/Render/Fly routers…)? Set this to the number
# of proxies in front of the app (usually 1). The sign-in rate limits then use the visitor's IP
# from X-Forwarded-For, and X-Forwarded-Proto=https gets Secure cookies. Leave it unset when
# the app is reachable directly: anyone could send those headers and dodge the limits.
# TRUST_PROXY=1

# --- Email (fallback) -----------------------------------------------------------
# Usually configured in the app under Settings → Email. These are used only when the
# app has no SMTP host saved. With neither, emails go to the outbox: they're shown in
# Settings → Email log (admins only) and printed to the server console.
#
# Gmail / Google Workspace (needs 2-Step Verification + an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@yourclub.com
# SMTP_PASS=your-16-char-app-password
#
# Resend (verify your domain first; the password is an API key):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx
#
# SMTP_FROM_EMAIL=booking@yourclub.com
# SMTP_FROM_NAME=The Laugh Track
# SMTP_REPLY_TO=booker@yourclub.com

# --- Hosted mode (many clubs on one server) ------------------------------------------
# Leave PLATFORM_URL unset for a self-hosted single club (everything above is all you need).
# Set it to run the hosted platform: the platform site (sign-up, "find my club", owner console)
# at PLATFORM_URL, and each club at <slug>.<its host>. Data: $DATA_DIR/platform.db plus one
# $DATA_DIR/clubs/<id>.db per club.
#
# Local dev: point it at the Vite port. Chrome, Firefox and Playwright resolve *.localhost to
# this machine, so club "broadway" is http://broadway.localhost:5173. Vite's /api proxy keeps
# the Host header, so the API sees which club you're on.
# PLATFORM_URL=http://localhost:5173
#
# Production (DNS: the apex and a * wildcard record both point at the server):
# PLATFORM_URL=https://comedybook.app
#
# Shown on the platform site and in platform emails. Default: Comedy Booking.
# PLATFORM_NAME=Comedy Booking
# Who is told about every new club and may use the owner console (comma-separated).
# PLATFORM_ADMIN_EMAILS=you@example.com
# Shown on the "account paused" and "sign-ups closed" pages. Default: the first admin email.
# SUPPORT_EMAIL=help@example.com
# open (default) or closed.
# SIGNUPS=open
# Required in hosted mode in production: encrypts mailbox passwords at rest.
# Generate one with: openssl rand -base64 32
# APP_SECRET=
# Platform-sender emails per club per club-local day (default 2000).
# PLATFORM_DAILY_EMAIL_CAP=2000
#
# In hosted mode the SMTP_* settings above are the platform's sender: platform emails go out
# as "<PLATFORM_NAME>" <SMTP_FROM_EMAIL>, and without SMTP_HOST they print to the console.
